# Component manager download cache (e.g. cJSON) — normally lands inside .pio/, this is a safety net
# in case anyone runs idf.py directly instead of through PlatformIO.
# Note: dependencies.lock is NOT ignored — commit it, it pins exact resolved component
# versions for reproducible builds, same idea as a package-lock.json.
managed_components/

